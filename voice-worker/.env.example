# LiveKit Cloud project "Kin Voice" (p_2vskskn8orb).
LIVEKIT_URL=wss://kin-voice-2jfqojz5.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match kin-backend's LIVEKIT_VOICE_AGENT_NAME env var — this is the
# explicit-dispatch name LiveKit routes calls to.
LIVEKIT_AGENT_NAME=kin-voice-agent

# kin-backend base URL + the shared FUNCTION_SECRET it also uses for
# /cron/* and other service-to-service routes.
KIN_BACKEND_URL=https://your-kin-backend.example.com
FUNCTION_SECRET=

# No provider API keys live here — every voice agent brings its own
# (BYOK), entered per-agent in the dashboard, encrypted at rest in
# kin-backend, and decrypted into the config this worker fetches per call
# (see worker.py's build_llm/build_stt/build_tts). Nothing to configure
# here for OpenAI/Deepgram/Cartesia/etc.
