# Copy this file to .env.local and fill in real values for local development.

# Supabase project URL — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) API key — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the kin-backend API this frontend talks to
NEXT_PUBLIC_BACKEND_URL=

# Public origin of this app, used for absolute URLs sent to third parties
# (e.g. Lemon Squeezy checkout redirect_url). Safe to leave blank locally —
# the app falls back to the request origin so dev checkouts round-trip to localhost.
NEXT_PUBLIC_SITE_URL=

# Lemon Squeezy hosted checkout URL for the product/variant being sold
NEXT_PUBLIC_LEMON_CHECKOUT_URL=

# Lemon Squeezy customer billing portal URL
NEXT_PUBLIC_LEMON_PORTAL_URL=

# Lemon Squeezy private API key (server-side secret, never expose client-side) —
# https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=

# Firebase project config, used only for GA4 analytics — see kin-backend/README
# for the primary auth/DB backend (Supabase). Safe to leave blank; analytics
# will simply be disabled.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
