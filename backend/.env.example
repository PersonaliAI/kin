# Copy this file to .env and fill in the values for your environment.
# In production, these are typically supplied via env.yaml (Cloud Run) or
# your platform's own secret/env config instead of a .env file — see
# README.md and CONTRIBUTING.md for details. Never commit real values.

# ---------------------------------------------------------------------------
# Supabase / Auth
# ---------------------------------------------------------------------------
SUPABASE_URL=                          # REQUIRED — your Supabase project URL
SUPABASE_SERVICE_ROLE_KEY=             # REQUIRED — Supabase service_role key (server-side only)
SUPABASE_ANON_KEY=
# Only used as a fallback if the project ever serves HS256 tokens. The modern
# flow is JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=
# NOTE: SUPABASE_DB_PASSWORD (a direct Postgres connection password) used to
# be documented here as "used for dynamic ALTER TABLE on leads". Removed
# during security-audit remediation — no code in this repo ever opens a
# direct Postgres connection or performs a dynamic ALTER TABLE; the
# credential was provisioned for a feature that was never built. Add it back
# with a fresh, narrowly-scoped value if that feature is ever implemented.

# ---------------------------------------------------------------------------
# Model Config (Gemini / LLM)
# ---------------------------------------------------------------------------
# Primary model. KIN_MODEL takes precedence; GEMMA_MODEL is a legacy alias.
KIN_MODEL=gemini-2.5-flash-lite
GEMMA_MODEL=
# Ordered fallback chain, tried in sequence on failure (quota/429, transient
# 5xx, etc). Comma-separated model names.
KIN_FALLBACK_MODELS=
# Google AI Studio API key (free tier) — set to route Gemini calls through AI
# Studio's own billing instead of Vertex AI. Leave blank to use Vertex AI.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Model used for OCR passes over documents, and the page cap per document.
KIN_OCR_MODEL=gemini-2.5-flash
KIN_OCR_MAX_PAGES=100
# Model used for memory-fact extraction from conversation.
KIN_EXTRACT_MODEL=gemini-2.5-flash
# Embedding model + vector dimensions for memory/RAG.
KIN_EMBED_MODEL=text-embedding-004
KIN_EMBED_DIMENSIONS=768
# Memory retrieval tuning: similarity threshold, top-K results, and the
# dedup threshold used when merging near-duplicate memories.
KIN_MEMORY_THRESHOLD=0.55
KIN_MEMORY_TOPK=5
KIN_MEMORY_DEDUP_THRESHOLD=0.90
# Feature flag: routes chat turns through the explicit LangGraph agent loop
# in plugins/graph_agent.py instead of the default loop. Truthy values: 1/true/yes.
KIN_USE_LANGGRAPH=

# ---------------------------------------------------------------------------
# Billing (Lemon Squeezy)
# ---------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_WEBHOOK_SECRET=          # legacy alias for LEMONSQUEEZY_WEBHOOK_SECRET
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_BASIC=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_EXECUTIVE=
# Alternate way to map variant_id -> plan name, comma-separated id:plan pairs.
LEMON_VARIANT_PLANS=

# ---------------------------------------------------------------------------
# CORS / Frontend
# ---------------------------------------------------------------------------
# Where the backend redirects after OAuth completes (fallback only).
FRONTEND_URL=https://personaliai.com
# Comma-separated list of origins allowed to call this API from the browser.
ALLOWED_ORIGINS=https://personaliai.com,https://chatty.personaliai.com,http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth (Calendar / Gmail)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Microsoft OAuth (Microsoft 365 / Azure AD)
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# ---------------------------------------------------------------------------
# BYOK (bring your own key)
# ---------------------------------------------------------------------------
# Symmetric key used to encrypt customer-supplied OpenAI/Anthropic/OpenRouter
# keys at rest. Rotating this invalidates all stored BYOK keys.
BYOK_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Notifications (OneSignal)
# ---------------------------------------------------------------------------
# Transactional meeting emails + push. Leave blank to fall back to the bot
# owner's connected Gmail (or just log if neither is set).
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_EMAIL_FROM=
ONESIGNAL_EMAIL_FROM_NAME=

# ---------------------------------------------------------------------------
# Social Providers (OAuth apps for posting)
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=

DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
DRIBBBLE_REDIRECT_URI=

TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
TUMBLR_REDIRECT_URI=

THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=

# Facebook + Instagram share one Meta app (FACEBOOK_APP_ID/SECRET).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
INSTAGRAM_REDIRECT_URI=

# Google Business Profile + YouTube reuse GOOGLE_CLIENT_ID/SECRET above; each
# needs its own redirect URI on the same OAuth client.
GMB_REDIRECT_URI=
YOUTUBE_REDIRECT_URI=

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=

KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=

# Farcaster via Neynar — one shared API key; each user approves their own
# "signer" in Warpcast (connect-manual, not OAuth redirect).
NEYNAR_API_KEY=

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Admin / Misc
# ---------------------------------------------------------------------------
# Gates /cron/*, /admin/*, and /internal/*; also doubles as the Telegram
# webhook query secret. Compared with hmac.compare_digest and fails CLOSED
# (rejects the request) if left unset — set a real random value before
# relying on any of these routes.
FUNCTION_SECRET=
# Signs/verifies OAuth-state JWTs (main.py _mint_state/_decode_state), kept
# separate from FUNCTION_SECRET so a leak of one doesn't compromise the
# other. Falls back to FUNCTION_SECRET (with a logged warning) if left
# unset, so nothing breaks before this is set — but should be given its own
# real random value.
OAUTH_STATE_SECRET=
# Shared secret for the internal /api/admin/* endpoints.
ADMIN_SECRET=
# Executive-tier "dedicated account manager" fallback contact.
EXECUTIVE_SUPPORT_NAME=
EXECUTIVE_SUPPORT_EMAIL=
EXECUTIVE_SUPPORT_CALENDLY_URL=
# System alert emails (e.g. Telegram webhook going silently empty).
ADMIN_ALERT_EMAIL=

# ---------------------------------------------------------------------------
# Rate Limiting (Upstash Redis REST)
# ---------------------------------------------------------------------------
# Shared cross-instance rate limiting for widget endpoints.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Monitoring (Sentry)
# ---------------------------------------------------------------------------
# Empty = monitoring disabled (no-op).
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# ---------------------------------------------------------------------------
# Search (Jina AI)
# ---------------------------------------------------------------------------
# Powers both web_search (s.jina.ai) and the crawl reader (r.jina.ai). Empty
# = web search degrades gracefully; crawl falls back to the keyless tier.
JINA_API_KEY=

# ---------------------------------------------------------------------------
# LiveKit Voice
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the agent_name kin-voice-worker registers on its AgentServer.
LIVEKIT_VOICE_AGENT_NAME=kin-voice-agent
# SIP trunk IDs (LiveKit project > Telephony), one per managed telephony provider.
LIVEKIT_TWILIO_OUTBOUND_TRUNK_ID=
LIVEKIT_TELNYX_OUTBOUND_TRUNK_ID=

# ---------------------------------------------------------------------------
# Telephony (Twilio / Telnyx managed-number provisioning, optional)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SIP_TRUNK_SID=

TELNYX_API_KEY=
TELNYX_SIP_CONNECTION_ID=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PORT=8080
